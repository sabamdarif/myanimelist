# ── Core ────────────────────────────────────────────────────────────────
DEBUG_MODE=False
# run this to generate the key:- python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=Django-secret-Key
# Comma-separated list of allowed hostnames (empty = allow all)
ALLOWED_HOSTS=your-domain.com
# Comma-separated full-URL origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Set to False when serving plain HTTP (e.g. docker-compose on a LAN without
# a TLS proxy in front) — also disables secure-only cookies and HSTS
SECURE_SSL_REDIRECT=True

# ── Database ────────────────────────────────────────────────────────────
# docker-compose: leave DATABASE_URL empty (the bundled postgres is used) and
# set POSTGRES_PASSWORD. External Postgres (Neon etc.): set DATABASE_URL and
# start compose without the db service (see docker-compose.yml).
# Outside docker: empty DATABASE_URL falls back to local SQLite.
POSTGRES_PASSWORD=pick-a-password
DATABASE_URL=
# Require TLS to the database (True for managed Postgres, False for the bundled one)
DB_SSL_REQUIRE=False

# ── Google login (allauth) ──────────────────────────────────────────────
# go to https://console.cloud.google.com/auth/clients and creat a new app and download the json file
# in Add Authorized Redirect URIs add https://yourdomain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=1234*************************.apps.googleusercontent.com
GOOGLE_SECRET=GO***********************fhd

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────
EMAIL_ADDRESS=YourGmail@gmail.com
EMAIL_HOST_USER=YourGmail@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# go to https://myaccount.google.com/u/9/apppasswords and add a new app and copy the password
EMAIL_PASSWORD=abcdefgh****

# ── Optional ────────────────────────────────────────────────────────────
# Redis cache (makes API throttles shared across gunicorn workers); LocMem otherwise
REDIS_URL=
# gunicorn worker count (docker)
GUNICORN_WORKERS=3
# host port nginx listens on (docker)
HTTP_PORT=8080
